{config, ...}: {
  hosts.server.profiles = ["base"];
  flake.modules.nixos.host-server = {
    # Headless host: user timers (warm-claude) have to fire without a login session.
    users.users.${config.username}.linger = true;
    # Generated by nixos-generate-config; `_` keeps import-tree from loading it as a flake-parts module.
    imports = [./_hardware-configuration.nix];
  };
}
