#!/usr/bin/env bash
# herdr-msg <to> <KIND> <text...>
# Re-asserts this agent's name, then sends "[herdr from:<me> pane:<pane>] <KIND> <text>" without waiting.
# <to> is a live agent name or a pane ID (use the pane: from the sender's header if the name is gone).
set -euo pipefail
[ $# -ge 3 ] || { echo "usage: herdr-msg <to> <TASK|DONE|FAILED|QUESTION|ANSWER|INFO|STOP|RENAMED> <text...>" >&2; exit 2; }
to=$1 kind=$2; shift 2
case "$kind" in TASK | DONE | FAILED | QUESTION | ANSWER | INFO | STOP | RENAMED) ;; *) echo "herdr-msg: unknown kind $kind" >&2; exit 2 ;; esac

here=$(dirname "$(readlink -f "$0")")
me=$("$here/herdr-name")
pane=$(herdr pane current --current | jq -r '.result.pane.pane_id')

msg="[herdr from:$me pane:$pane] $kind $*"

# omp receivers: hand the message to the herdr-inbox extension's socket, so the user's
# draft in that prompt is never touched. Anything else (Claude Code, opencode, an omp
# without the inbox): type it in with `herdr agent prompt`.
err= inbox=
if info=$(herdr agent get "$to" 2>/dev/null) && [ "$(jq -r '.result.agent.agent' <<<"$info")" = omp ]; then
  [ "$(jq -r '.result.agent.agent_status' <<<"$info")" = blocked ] && err=agent_blocked
  target=$(jq -r '.result.agent.pane_id' <<<"$info")
  for pid in $(herdr pane process-info --pane "$target" | jq -r '.result.process_info.foreground_processes[] | select(.name == "omp") | .pid'); do
    s=${XDG_RUNTIME_DIR:-/tmp}/omp-inbox/$pid.sock
    [ -S "$s" ] && inbox=$s && break
  done
fi

if [ -z "$err" ]; then
  if [ -n "$inbox" ]; then
    printf '%s' "$msg" | socat -u - "UNIX-CONNECT:$inbox" 2>/dev/null || err="inbox $inbox refused the message"
  else
    err=$(herdr agent prompt "$to" "$msg" 2>&1 >/dev/null) || true
  fi
fi
if [ -n "$err" ]; then
  case "$err" in
    *agent_not_found*) echo "herdr-msg: '$to' not found; it may have been renamed or lost its name. Use the pane ID from its last header, or find it: herdr agent list" >&2 ;;
    *agent_blocked*) echo "herdr-msg: '$to' is at an approval/question dialog (the user's). Not sent; wait for it to clear, then resend once." >&2 ;;
    *) echo "herdr-msg: $err" >&2 ;;
  esac
  exit 1
fi
echo "sent to $to as $me"
